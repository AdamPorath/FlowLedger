{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "FlowLedger.Identity",
    "Audience": "FlowLedger"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "transactions-route": {
        "ClusterId": "transactions-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/transactions/{**catch-all}"
        }
      },
      "consolidation-route": {
        "ClusterId": "consolidation-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/consolidation/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://identity-api"
          }
        }
      },
      "transactions-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://transactions-api"
          }
        }
      },
      "consolidation-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://consolidation-api"
          }
        }
      }
    }
  }
}